{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["jest"]
  },
  "include": ["src", "App.tsx", "index.js", "__tests__"],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "babel.config.js",
    "jest.config.js",
    "metro.config.js"
  ]
}
