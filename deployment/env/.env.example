# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-secret-manager-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Service-owned PostgreSQL 17
POSTGRES_DB=spacewhy
POSTGRES_USER=spacewhy
POSTGRES_PASSWORD=replace-with-a-secret-manager-value
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# RabbitMQ 4.3 / Celery broker
RABBITMQ_DEFAULT_USER=spacewhy
RABBITMQ_DEFAULT_PASS=replace-with-a-secret-manager-value
CELERY_BROKER_URL=amqp://spacewhy:replace-with-a-secret-manager-value@rabbitmq:5672//

# Redis 8.8
REDIS_URL=redis://redis:6379/0
