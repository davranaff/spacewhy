# Application
APP__ENVIRONMENT=local
APP__DEBUG=true
APP__VERIFY_DEPENDENCIES_ON_STARTUP=false
API__TITLE=Spacewhy API
API__DESCRIPTION=Spacewhy platform API.
API__PREFIX=/api/v1
API__DOCS_ENABLED=true
API__OPENAPI_ENABLED=true

# HTTP security. JSON arrays make nested Pydantic settings unambiguous.
SECURITY__TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
SECURITY__CORS_ALLOWED_ORIGINS=["http://localhost:8081","http://localhost:8082","http://localhost:8083","https://drop.spacewhy.uz","https://finance.spacewhy.uz"]
SECURITY__CORS_ALLOWED_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
SECURITY__CORS_ALLOWED_HEADERS=["Authorization","Content-Type","Idempotency-Key","X-Request-ID"]
SECURITY__CORS_ALLOW_CREDENTIALS=false
SECURITY__PROXY_HEADERS_ENABLED=false
SECURITY__TRUSTED_PROXY_HOSTS=[]

# Service-owned PostgreSQL 17. This is a safe local development password only.
POSTGRES_DB=spacewhy
POSTGRES_USER=spacewhy
POSTGRES_PASSWORD=spacewhy_local_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
DATABASE__URL=postgresql+asyncpg://spacewhy:spacewhy_local_password@postgres:5432/spacewhy
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=5
DATABASE__POOL_TIMEOUT_SECONDS=30
DATABASE__POOL_RECYCLE_SECONDS=1800
DATABASE__COMMAND_TIMEOUT_SECONDS=15
DATABASE__HEALTH_TIMEOUT_SECONDS=2

# Core internationalization
I18N__DEFAULT_LOCALE=en
I18N__SUPPORTED_LOCALES=["ru","uz","en"]
I18N__ACCEPT_LANGUAGE_MAX_LENGTH=512

# Bot platform. Keep example apps disabled until isolated real credentials are supplied through
# the approved secret path. Placeholder values are intentionally rejected when ENABLED=true.
BOTS__WEBHOOK_MAX_PAYLOAD_BYTES=1048576

BOTS__APPS__SUPPORT_BOT__PROVIDER=telegram
BOTS__APPS__SUPPORT_BOT__ENABLED=false
BOTS__APPS__SUPPORT_BOT__WEBHOOK_ENABLED=true
BOTS__APPS__SUPPORT_BOT__TOKEN=replace-with-secret
BOTS__APPS__SUPPORT_BOT__WEBHOOK_SECRET=replace-with-a-unique-webhook-secret
BOTS__APPS__SUPPORT_BOT__DEFAULT_LOCALE=ru
BOTS__APPS__SUPPORT_BOT__SUPPORTED_LOCALES=["ru","uz","en"]
BOTS__APPS__SUPPORT_BOT__REQUEST_TIMEOUT_SECONDS=10
BOTS__APPS__SUPPORT_BOT__CONNECT_TIMEOUT_SECONDS=5
BOTS__APPS__SUPPORT_BOT__PROCESSING_TIMEOUT_SECONDS=10
BOTS__APPS__SUPPORT_BOT__VALIDATE_IDENTITY_ON_STARTUP=false

BOTS__APPS__SALES_ASSISTANT__PROVIDER=telegram
BOTS__APPS__SALES_ASSISTANT__ENABLED=false
BOTS__APPS__SALES_ASSISTANT__WEBHOOK_ENABLED=true
BOTS__APPS__SALES_ASSISTANT__TOKEN=replace-with-another-secret
BOTS__APPS__SALES_ASSISTANT__WEBHOOK_SECRET=replace-with-another-unique-webhook-secret
BOTS__APPS__SALES_ASSISTANT__DEFAULT_LOCALE=uz
BOTS__APPS__SALES_ASSISTANT__SUPPORTED_LOCALES=["uz","ru","en"]
BOTS__APPS__SALES_ASSISTANT__REQUEST_TIMEOUT_SECONDS=10
BOTS__APPS__SALES_ASSISTANT__CONNECT_TIMEOUT_SECONDS=5
BOTS__APPS__SALES_ASSISTANT__PROCESSING_TIMEOUT_SECONDS=10
BOTS__APPS__SALES_ASSISTANT__VALIDATE_IDENTITY_ON_STARTUP=false

# Booking owns this app registration and its isolated gettext catalog scope. Keep it disabled
# until a real token and a unique webhook secret are supplied through deployment/env/.env.
BOTS__APPS__BOOKING_BOT__PROVIDER=telegram
BOTS__APPS__BOOKING_BOT__ENABLED=false
BOTS__APPS__BOOKING_BOT__WEBHOOK_ENABLED=true
BOTS__APPS__BOOKING_BOT__TOKEN=replace-with-booking-bot-secret
BOTS__APPS__BOOKING_BOT__WEBHOOK_SECRET=replace-with-a-unique-booking-webhook-secret
BOTS__APPS__BOOKING_BOT__DEFAULT_LOCALE=ru
BOTS__APPS__BOOKING_BOT__SUPPORTED_LOCALES=["ru","uz","en"]
BOTS__APPS__BOOKING_BOT__REQUEST_TIMEOUT_SECONDS=10
BOTS__APPS__BOOKING_BOT__CONNECT_TIMEOUT_SECONDS=5
BOTS__APPS__BOOKING_BOT__PROCESSING_TIMEOUT_SECONDS=10
BOTS__APPS__BOOKING_BOT__VALIDATE_IDENTITY_ON_STARTUP=false

# Identity owns the shared panel and Finance authentication bot. The real token was deliberately
# omitted and must be supplied only after the exposed credential has been rotated through BotFather.
BOTS__APPS__SPACEWHY_AUTH_BOT__PROVIDER=telegram
BOTS__APPS__SPACEWHY_AUTH_BOT__ENABLED=false
BOTS__APPS__SPACEWHY_AUTH_BOT__WEBHOOK_ENABLED=true
BOTS__APPS__SPACEWHY_AUTH_BOT__TOKEN=replace-with-rotated-spacewhy-auth-bot-secret
BOTS__APPS__SPACEWHY_AUTH_BOT__WEBHOOK_SECRET=replace-with-a-unique-auth-webhook-secret
BOTS__APPS__SPACEWHY_AUTH_BOT__DEFAULT_LOCALE=ru
BOTS__APPS__SPACEWHY_AUTH_BOT__SUPPORTED_LOCALES=["ru","uz","en"]
BOTS__APPS__SPACEWHY_AUTH_BOT__REQUEST_TIMEOUT_SECONDS=10
BOTS__APPS__SPACEWHY_AUTH_BOT__CONNECT_TIMEOUT_SECONDS=5
BOTS__APPS__SPACEWHY_AUTH_BOT__PROCESSING_TIMEOUT_SECONDS=10
BOTS__APPS__SPACEWHY_AUTH_BOT__VALIDATE_IDENTITY_ON_STARTUP=false

# Shared Identity module. Session material must be replaced independently in production through
# SECURITY__SESSION_SIGNING_SECRET; no raw OTP is stored in PostgreSQL.
IDENTITY_BOT_APP_ID=spacewhy_auth_bot
IDENTITY_OTP_TTL_SECONDS=300
IDENTITY_OTP_ATTEMPTS=5
IDENTITY_ACCESS_TOKEN_TTL_SECONDS=900
IDENTITY_HANDOFF_TTL_SECONDS=60
IDENTITY_WEBAPP_MAX_AGE_SECONDS=600

# Booking module tuning. The worker is a separate process and remains inert until
# a booking bot installation exists in PostgreSQL.
BOOKING_WEBAPP_MAX_AGE_SECONDS=600
BOOKING_AUTH_RATE_LIMIT_REQUESTS=20
BOOKING_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
BOOKING_AVAILABILITY_MAX_DAYS=31
BOOKING_WORKER_POLL_SECONDS=2
BOOKING_WORKER_BATCH_SIZE=50
BOOKING_WORKER_LEASE_SECONDS=300
BOOKING_CALLBACK_TTL_SECONDS=900

# Logging and observability
LOGGING__LEVEL=INFO
LOGGING__JSON_LOGS=false
OBSERVABILITY__ENABLED=false
OBSERVABILITY__SERVICE_NAME=spacewhy-backend
